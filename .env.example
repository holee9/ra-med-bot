# Regula — environment variables (Phase 1)
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local`. lib/env.ts validates these on startup (REQ-FND-010a).

# --- Database (Postgres 16, see handoff §4) -----------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/regula

# --- Auth.js v5 (NextAuth) ----------------------------------------------------
# Generate with: openssl rand -base64 32  (must be >= 32 chars)
AUTH_SECRET=replace-with-32-plus-character-random-string
NEXTAUTH_URL=http://localhost:3000

# --- Microsoft Entra ID (Azure AD) SSO ---------------------------------------
AUTH_MICROSOFT_ENTRA_ID=
AUTH_MICROSOFT_SECRET=
AUTH_MICROSOFT_TENANT_ID=

# --- Google SSO ---------------------------------------------------------------
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- LLM providers (Phase 2) --------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-replace-with-real-key
OPENAI_API_KEY=sk-replace-with-real-key
# Optional: label shown in the UI for the model
# NEXT_PUBLIC_LLM_MODEL_LABEL=Claude Sonnet 4.5

# --- Cloudflare Vectorize (Phase 7) -------------------------------------------
# Set ONLY in the Cloudflare Workers runtime to dispatch public-corpus queries
# to the Vectorize binding. Leave empty for local dev, vitest, and Next.js
# Node server — the hybrid router falls back to pgvector automatically
# (REQ-QUAL-012, REQ-QUAL-013, see lib/ai/hybrid-router.ts isVectorizeAvailable()).
CLOUDFLARE_VECTORIZE_INDEX_NAME=

# --- Object storage (Phase 4+) ------------------------------------------------
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=

# --- Observability (REQ-ENTERPRISE-049~052) ------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com
