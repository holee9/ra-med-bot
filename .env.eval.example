# Eval harness environment variables
# Copy to .env.eval and fill in real values before running eval:ci

# Anthropic API key for LLM eval
ANTHROPIC_API_KEY_EVAL=sk-ant-...

# Langfuse observability (LLM trace)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASEURL=https://cloud.langfuse.com
