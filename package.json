{
  "name": "regula",
  "version": "1.0.0",
  "private": true,
  "description": "Regula — Medical device regulatory affairs (RA) expert AI chatbot",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "echo 'Error: Use pnpm dev:public for validated dev server. Direct pnpm dev bypasses env validation and is forbidden.' && exit 1",
    "dev:public": "node --experimental-strip-types scripts/validate-runtime-env.ts && next dev --hostname 0.0.0.0 --port ${PORT:-3000}",
    "dev:bootstrap": "node --experimental-strip-types scripts/dev-bootstrap.ts",
    "admin:create": "pnpm dlx tsx scripts/create-admin.ts",
    "build": "REGULA_ALLOW_ENV_VALIDATION_SKIP=build SKIP_ENV_VALIDATION=1 next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && pnpm lint:hex",
    "lint:fix": "biome check --write .",
    "lint:hex": "node scripts/no-hex-colors.mjs",
    "format": "biome format . --write",
    "test": "vitest run",
    "bench:audit": "vitest run lib/audit/__tests__/writeAudit.bench.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "env:test": "node --experimental-strip-types scripts/e2e-env.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down --remove-orphans",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d db",
    "db:test:down": "docker compose -f docker-compose.test.yml down --remove-orphans",
    "db:test:migrate": "pnpm env:test drizzle-kit push --config drizzle.config.ts",
    "db:test:seed": "pnpm env:test node --experimental-strip-types scripts/seed-test-db.ts",
    "test:e2e:setup": "pnpm db:test:up && pnpm db:test:migrate && pnpm db:test:seed",
    "test:e2e:local": "pnpm env:test playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed:corpus": "pnpm dlx tsx scripts/seed-corpus.ts",
    "ci:typecheck": "pnpm typecheck",
    "ci:lint": "pnpm lint",
    "ci:format": "biome format .",
    "ci:test": "vitest run",
    "ci:coverage": "vitest run --coverage",
    "ci:rbac": "node --experimental-strip-types scripts/qa/check-rbac.mjs",
    "ci:audit": "node --experimental-strip-types scripts/qa/audit-completeness.ts",
    "ci:tokens": "node --experimental-strip-types scripts/ci/tokens-symmetry.ts",
    "ci:i18n": "node --experimental-strip-types scripts/ci/i18n-completeness.ts",
    "ci:glossary": "node --experimental-strip-types scripts/ci/regulatory-glossary.ts",
    "ci:contrast": "node --experimental-strip-types scripts/ci/contrast-check.ts",
    "ci:module-boundaries": "node --experimental-strip-types scripts/ci/module-boundaries.ts",
    "ci:migrations": "node --experimental-strip-types scripts/ci/check-migrations.ts",
    "qa:gate-0": "tsx scripts/qa-gate-0-checklist.ts",
    "qa:gate-0:comment": "tsx scripts/qa-gate-0-checklist.ts $1 | gh issue comment $1 --body-file -",
    "qa:gate-1": "tsx scripts/qa-gate-1-checklist.ts",
    "qa:gate-1:comment": "tsx scripts/qa-gate-1-checklist.ts $1 | gh issue comment $1 --body-file -",
    "ingest:gitea-wiki": "tsx scripts/ingest-gitea-wiki.ts",
    "ci:build": "pnpm build",
    "eval:ci": "promptfoo eval --config tests/eval/promptfoo.config.yaml --output tests/eval/results/latest.json",
    "load:staging": "BASE_URL=$STAGING_URL bash scripts/run-load.sh staging",
    "load:mock": "bash scripts/run-load.sh mock",
    "preflight": "bash scripts/preflight.sh",
    "preflight:fast": "bash scripts/preflight.sh --skip-eval --skip-e2e --skip-load",
    "tokens:check": "pnpm ci:tokens",
    "modules:check": "pnpm ci:module-boundaries",
    "contrast:check": "pnpm ci:contrast",
    "i18n:check": "pnpm ci:i18n",
    "a11y": "playwright test tests/e2e/a11y.spec.ts",
    "rbac:check": "pnpm ci:rbac",
    "audit:check": "pnpm ci:audit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": ["biome check --write --no-errors-on-unmatched"]
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.58",
    "@auth/drizzle-adapter": "^1.4.0",
    "@fontsource/pretendard": "^5.0.0",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.51.0",
    "@tanstack/react-query": "^5.51.0",
    "@tanstack/react-virtual": "^3.10.0",
    "@types/dompurify": "^3.2.0",
    "@vercel/analytics": "^2.0.1",
    "ai": "^3.3.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "dompurify": "^3.4.10",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^11.5.4",
    "htmlparser2": "^12.0.0",
    "inngest": "^4.7.0",
    "langfuse": "^3.38.20",
    "lucide-react": "^0.451.0",
    "next": "^15.5.18",
    "next-auth": "^5.0.0-beta.20",
    "next-intl": "^4.11.0",
    "ollama-ai-provider": "^1.2.0",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.4",
    "posthog-js": "^1.372.6",
    "posthog-node": "^5.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.0",
    "react-markdown": "^9.0.1",
    "recharts": "^2.15.4",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.2",
      "devalue": ">=5.8.1",
      "fast-xml-builder": ">=1.1.7",
      "esbuild@<=0.24.2": ">=0.25.0",
      "jsondiffpatch@<0.7.2": ">=0.7.2",
      "postcss@<8.5.10": ">=8.5.10",
      "hono@<4.12.18": ">=4.12.18",
      "ip-address@<=10.1.0": ">=10.1.1",
      "svelte@>=5.46.0 <=5.55.6": ">=5.55.7",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "protobufjs@>=8.0.0 <8.2.0": ">=8.2.0",
      "protobufjs@<=7.5.7": ">=7.5.8",
      "@anthropic-ai/sdk@>=0.79.0 <0.91.1": ">=0.91.1",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "axios@>=1.0.0 <1.16.0": ">=1.16.0",
      "hono@<4.12.21": ">=4.12.21",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "svelte@<=5.55.6": ">=5.55.7",
      "svelte@>=5.51.5 <=5.55.6": ">=5.55.7",
      "axios@>=1.7.0 <1.16.0": ">=1.16.0",
      "axios@=1.15.2": ">=1.16.0",
      "esbuild@>=0.17.0 <0.28.1": ">=0.28.1",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "protobufjs@>=8.0.0 <=8.5.0": ">=8.6.0",
      "protobufjs@<=7.6.2": ">=7.6.3",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "js-yaml@<=4.1.1": ">=4.2.0",
      "@babel/core@<=7.29.0": ">=7.29.6",
      "protobufjs@>=8.0.0 <=8.4.0": ">=8.4.1",
      "protobufjs@<=7.6.0": ">=7.6.1",
      "@opentelemetry/core@<2.8.0": ">=2.8.0"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "^1.9.2",
    "@playwright/test": "^1.45.0",
    "@tailwindcss/postcss": "^4.0.0-alpha.20",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/recharts": "^2.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "jsdom": "^24.1.1",
    "lint-staged": "^17.0.8",
    "postcss": "^8.4.41",
    "promptfoo": "^0.121.9",
    "tailwindcss": "^4.0.0-alpha.20",
    "ts-morph": "^28.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.4.0",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  }
}
