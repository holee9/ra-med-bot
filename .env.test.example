# Regula local E2E environment.
# Copy this file to .env.test before running pnpm test:e2e:setup.

DATABASE_URL=postgresql://postgres:test@localhost:5433/regula_test
AUTH_SECRET=test-placeholder-auth-secret-padded-to-32-chars-min
NEXTAUTH_URL=http://localhost:3000

AUTH_MICROSOFT_ID=test-placeholder-microsoft-client
AUTH_MICROSOFT_SECRET=test-placeholder-microsoft-secret
AUTH_GOOGLE_ID=test-placeholder-google-client
AUTH_GOOGLE_SECRET=test-placeholder-google-secret

ANTHROPIC_API_KEY=test-placeholder-anthropic
OPENAI_API_KEY=test-placeholder-openai
NEXT_PUBLIC_LLM_MODEL_LABEL=local-e2e

PLAYWRIGHT_BASE_URL=http://localhost:3000

# Set these only when a dedicated non-production SSO test account exists.
# E2E_TEST_USER_EMAIL=e2e.ra@example.test
# E2E_TEST_USER_PASSWORD=replace-with-test-only-password
# PLAYWRIGHT_AUTH_STATE=tests/e2e/fixtures/.auth.json
